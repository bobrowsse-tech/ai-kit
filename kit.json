{
  "name": "ai-kit",
  "version": "1.6.0",
  "$comment": "First matching rule wins; unmatched files are 'seed'. owned: kit-managed, refreshed on --update unless you modified them (then a .kit-new file is written). seed: created once, never touched again (docs, config, CODEOWNERS...). merge-doc: AGENTS.md (a differing existing file gets AGENTS.kit.md next to it). json-merge: settings merged additively; entries the kit previously shipped and later dropped are removed.",
  "rules": [
    {
      "prefix": "scripts/ai/",
      "class": "owned"
    },
    {
      "path": ".cursor/hooks.json",
      "class": "owned"
    },
    {
      "path": ".codex/hooks.json",
      "class": "owned"
    },
    {
      "path": ".github/hooks/ai-kit.json",
      "class": "owned"
    },
    {
      "path": ".gemini/settings.json",
      "class": "json-merge"
    },
    {
      "prefix": ".claude/skills/reuse-first/",
      "class": "owned"
    },
    {
      "prefix": ".claude/skills/project-bootstrap/",
      "class": "owned"
    },
    {
      "prefix": ".claude/skills/project-memory/",
      "class": "owned"
    },
    {
      "prefix": ".claude/skills/verify-and-ship/",
      "class": "owned"
    },
    {
      "prefix": ".claude/skills/mcp-tools/",
      "class": "owned"
    },
    {
      "prefix": ".claude/skills/pre-ship-security/",
      "class": "owned"
    },
    {
      "prefix": ".claude/skills/modern-css-workflows/",
      "class": "owned"
    },
    {
      "path": "docs/security-checklist.md",
      "class": "seed"
    },
    {
      "path": ".github/workflows/ai-guardrails.yml",
      "class": "owned"
    },
    {
      "path": ".github/pull_request_template.md",
      "class": "owned"
    },
    {
      "prefix": ".githooks/",
      "class": "owned"
    },
    {
      "path": ".husky/pre-commit",
      "class": "owned"
    },
    {
      "path": ".ai/mcp-catalog.json",
      "class": "owned"
    },
    {
      "path": ".claude/settings.json",
      "class": "json-merge"
    },
    {
      "path": "AGENTS.md",
      "class": "merge-doc"
    },
    {
      "path": ".pre-commit-config.yaml",
      "class": "seed",
      "when": "python"
    }
  ]
}
