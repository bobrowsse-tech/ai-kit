{
  "name": "ai-kit-monorepo",
  "private": true,
  "version": "1.6.0",
  "description": "AI Project Kit monorepo — CLI (@bobrowsse-tech/ai-kit) and shared core; VS Code extension comes next.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "stage": "npm run stage -w @bobrowsse-tech/ai-kit",
    "test": "npm run stage && node tests/run.mjs && npm run test -w ai-kit",
    "test:live": "npm run stage && node tests/live-smoke.mjs",
    "pack:cli": "npm run stage -w @bobrowsse-tech/ai-kit && npm pack -w @bobrowsse-tech/ai-kit",
    "pack:ext": "npm run package -w ai-kit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobrowsse-tech/ai-kit.git"
  },
  "homepage": "https://github.com/bobrowsse-tech/ai-kit#readme"
}
